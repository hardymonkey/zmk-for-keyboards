#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LETTER_SUB 1
#define NUM 2
#define NUM_SUB 3
#define SYM 4
#define SYM_SUB 5
#define FN 6

/ {
    chosen {
        zmk,underglow = &led_strip;
    };

    behaviors {
        /* พฤติกรรมปุ่ม Space: Tap ได้ Space / Hold หรือกดพร้อมปุ่มอื่นเข้า LETTER_SUB */
        lt_spc: lt_space_sub {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SPACE_SUB";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <125>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Default FrogPad Layer */
        default_layer {
            bindings = <
&sl NUM    &kp P &kp W &kp R &kp A &kp F    &none &none &none &none &none &none
&kp ENTER  &kp D &kp T &kp H &kp E &kp O    &none &none &none &none &none &none
&kp LSHFT  &kp Y &kp S &kp N &kp I &kp U    &none &none &none &none &none &none
                       &sl SYM &mo FN &lt_spc LETTER_SUB SPACE &none &none &none
            >;
        };

        /* Layer 1: Letter Sub Layer (กด Space ค้างแล้วกดปุ่มอื่น) */
        letter_sub {
            bindings = <
&kp QUESTION &kp J &kp W &kp B &kp MINUS &kp AT      &none &none &none &none &none &none
&kp DOT      &kp V &kp C &kp L &kp Z     &kp Q       &none &none &none &none &none &none
&trans       &kp X &kp G &kp K &kp DQUOT &kp BSPC    &none &none &none &none &none &none
                         &trans &trans &trans        &none &none &none
            >;
        };

        /* Layer 2: Num Layer ( One-shot กดปุ่มเดียวเด้งกลับ ) */
        num {
            bindings = <
&trans    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &none &none &none &none &none &none
&trans    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0    &none &none &none &none &none &none
&trans    &kp PLUS &kp MINUS &kp STAR &kp SLASH &kp EQUAL &none &none &none &none &none &none
                        &sl NUM_SUB &trans &lt_spc NUM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 3: Num Sub Layer */
        num_sub {
            bindings = <
&trans    &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT    &none &none &none &none &none &none
&trans    &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR  &none &none &none &none &none &none
&trans    &none &none &none &none &none                  &none &none &none &none &none &none
                          &trans &trans &trans           &none &none &none
            >;
        };

        /* Layer 4: Sym Layer ( One-shot กดปุ่มเดียวเด้งกลับ ) */
        sym {
            bindings = <
&trans    &kp LBRC &kp RBRC &kp LBKT &kp RBKT &kp GRAVE  &none &none &none &none &none &none
&trans    &kp LPAR &kp RPAR &kp BSLH &kp PIPE &kp TILDE  &none &none &none &none &none &none
&trans    &kp COMMA &kp DOT &kp SLASH &kp SQT &kp SEMI   &none &none &none &none &none &none
                            &trans &sl SYM_SUB &lt_spc SYM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 5: Sym Sub Layer */
        sym_sub {
            bindings = <
&trans    &kp ESC &kp TAB &kp CAPS &kp INS &kp DEL       &none &none &none &none &none &none
&trans    &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp HOME    &none &none &none &none &none &none
&trans    &kp PG_UP &kp PG_DN &kp END &none &none        &none &none &none &none &none &none
                              &trans &trans &trans       &none &none &none
            >;
        };

        /* Layer 6: Fn Layer (กด Fn ค้างแล้วกด Num/Sym เพื่อ Lock/Unlock) */
        fn {
            bindings = <
&tog NUM  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5         &none &none &none &none &none &none
&trans    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10        &none &none &none &none &none &none
&trans    &kp F11 &kp F12 &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &none &none &none &none &none &none
                          &tog SYM &trans &trans         &none &none &none
            >;
        };

        extra1 {
            status = "reserved";
        };
        extra2 {
            status = "reserved";
        };
        extra3 {
            status = "reserved";
        };
        extra4 {
            status = "reserved";
        };
    };
};

/* Pin control และ SPI Configuration อยู่นอก Root Block */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <3200000>;
        chain-length = <27>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <2 1 3>;
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LETTER_SUB 1
#define NUM 2
#define NUM_SUB 3
#define SYM 4
#define SYM_SUB 5
#define FN 6

/ {
    behaviors {
        /* Custom Hold-Tap สำหรับปุ่ม Space (Tap = Space / Hold = สลับไป Sub-Layer) */
        lt_spc: lt_space_sub {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SPACE_SUB";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <125>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Default Layer (มือซ้ายข้างเดียว) */
        default_layer {
            bindings = <
&sl NUM    &kp P  &kp W  &kp R  &kp A  &kp F    &none &none &none &none &none &none
&kp ENTER  &kp D  &kp T  &kp H  &kp E  &kp O    &none &none &none &none &none &none
&kp LSHFT  &kp Y  &kp S  &kp N  &kp I  &kp U    &none &none &none &none &none &none
                         &sl SYM &mo FN &lt_spc LETTER_SUB SPACE &none &none &none
            >;
        };

letter_sub {
            bindings = <
&kp AT   &kp J  &kp M  &kp B  &kp SQT   &kp TAB    &none &none &none &none &none &none
&kp DOT  &kp V  &kp C  &kp L  &kp Z     &kp Q      &none &none &none &none &none &none
&trans   &kp X  &kp G  &kp K  &kp DQT &kp BSPC   &none &none &none &none &none &none
                       &kp COMMA &mo FN &trans     &none &none &none
            >;
        };

        /* Layer 2: NUM */
        num_layer {
            bindings = <
&sl NUM    &kp MINUS  &kp N7  &kp N8  &kp N9  &kp SLASH    &none &none &none &none &none &none
&kp ENTER  &kp PLUS   &kp N4  &kp N5  &kp N6  &kp STAR     &none &none &none &none &none &none
&kp LSHFT  &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL    &none &none &none &none &none &none
                              &sl SYM &mo FN  &lt_spc NUM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 3: NUM_SUB */
        num_sub_layer {
            bindings = <
&sl NUM    &kp F12  &kp F7  &kp F8  &kp F9  &kp PRCNT    &none &none &none &none &none &none
&kp ENTER  &kp F11  &kp F4  &kp F5  &kp F6  &kp AMPS     &none &none &none &none &none &none
&kp LSHFT  &kp F10  &kp F1  &kp F2  &kp F3  &kp DLLR     &none &none &none &none &none &none
                    &sl SYM &mo FN  &trans               &none &none &none
            >;
        };

        /* Layer 4: SYM */
        sym_layer {
            bindings = <
&sl NUM    &kp SEMI   &kp COLON &kp STAR &kp AMPS  &kp QUESTION &none &none &none &none &none &none
&kp ENTER  &kp UNDER  &kp AT    &kp MINUS &kp PRCNT &kp SLASH    &none &none &none &none &none &none
&kp LSHFT  &kp LBRC   &kp LBKT  &kp LPAR  &kp LT    &kp DQT    &none &none &none &none &none &none
                                &sl SYM   &mo FN    &lt_spc SYM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 5: SYM_SUB */
        sym_sub_layer {
            bindings = <
&sl NUM    &kp HASH  &kp DLLR  &kp EQUAL &kp PLUS  &kp EXCL     &none &none &none &none &none &none
&kp ENTER  &kp CARET &kp TILDE &kp PIPE  &kp GRAVE &kp BSLH     &none &none &none &none &none &none
&kp LSHFT  &kp RBRC  &kp RBKT  &kp RPAR  &kp GT    &kp SQT      &none &none &none &none &none &none
                               &sl SYM   &mo FN    &trans       &none &none &none
            >;
        };

        /* Layer 6: FN */
        fn_layer {
            bindings = <
&kp LGUI       &kp PG_UP  &kp PAUSE_BREAK &kp END    &kp HOME   &kp ESC      &none &none &none &none &none &none
&kp LNLCK      &kp PG_DN  &kp UP          &kp LALT   &kp LCTRL  &kp INS      &none &none &none &none &none &none
&kp SLCK       &kp LEFT   &kp DOWN        &kp RIGHT  &kp PSCRN  &kp DEL      &none &none &none &none &none &none
                                          &sl SYM    &trans     &sl NUM      &none &none &none
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};

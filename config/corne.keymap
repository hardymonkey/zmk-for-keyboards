#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LETTER_SUB 1
#define NUM 2
#define NUM_SUB 3
#define SYM 4
#define SYM_SUB 5
#define FN 6
#define SHORTCUT 7

/ {
    behaviors {
        /* Custom Hold-Tap สำหรับปุ่ม Space (Tap = Space / Hold = สลับไป Sub-Layer) */
        lt_spc: lt_space_sub {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SPACE_SUB";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <125>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        /* Tap-Dance Shift: 1 ที = Shift ปกติ, 2 ที = Shift Lock (&kt), 3 ที = Caps Lock */
        td_shift_advanced: tap_dance_shift_advanced {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SHIFT_ADVANCED";
            #binding-cells = <0>;
            tapping-term-ms = <250>; /* ปรับเวลาหน้าต่างการกดเป็น 250ms เพื่อให้เคาะ 3 ครั้งได้ง่ายขึ้น */
            bindings = <&kp LSHFT>, <&kt LSHFT>, <&kp CAPS>;
        };

        /* Tap-Dance สำหรับ NUM: กด 1 ที = &sl NUM / กด 2 ที = &tog NUM */
        td_num: tap_dance_num {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_NUM";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sl NUM>, <&tog NUM>;
        };

        /* 2. Hold-Tap สำหรับ SYM: กดปล่อย = &sl SYM / กดค้าง = เปิด Shortcut Layer (Layer #7) */
        ht_sym_shortcut: hold_tap_sym_shortcut {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SYM_SHORTCUT";
            #binding-cells = <2>;
            flavor = "balanced";       /* ปรับเป็น balanced เพื่อให้เคาะ Tap ได้ไวและเด็ดขาดขึ้น */
            tapping-term-ms = <170>;   /* ลดเวลาลงเล็กน้อยเพื่อให้ส่ง &sl เร็วขึ้น */
            quick-tap-ms = <125>;      /* ช่วยให้กดพิมพ์รัวๆ ต่อเนื่องได้ไม่หลุด */
            bindings = <&mo>, <&sl>;
        };

    };

    combos {
        compatible = "zmk,combos";
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Default Layer (มือซ้ายข้างเดียว) */
        default_layer {
            bindings = <
&td_num              &kp P  &kp W  &kp R  &kp A  &kp F                &none &none &none &none &none &none
&kp ENTER            &kp D  &kp T  &kp H  &kp E  &kp O                &none &none &none &none &none &none
&td_shift_advanced   &kp Y  &kp S  &kp N  &kp I  &kp U                &none &none &none &none &none &none
                     &ht_sym_shortcut SHORTCUT SYM   &mo FN    &lt_spc LETTER_SUB SPACE    &none &none &none
            >;
        };

        letter_sub {
            bindings = <
&kp AT   &kp J  &kp M  &kp B  &kp SQT   &kp TAB        &none &none &none &none &none &none
&kp DOT  &kp V  &kp C  &kp L  &kp Z     &kp Q          &none &none &none &none &none &none
&trans   &kp X  &kp G  &kp K  &kp DQT   &kp BSPC       &none &none &none &none &none &none
                &kp COMMA    &kp QUESTION   &trans     &none &none &none
            >;
        };

        /* Layer 2: NUM */
        num_layer {
            bindings = <
&trans       &kp MINUS  &kp N7  &kp N8  &kp N9  &kp SLASH        &none &none &none &none &none &none
&trans       &kp PLUS   &kp N4  &kp N5  &kp N6  &kp STAR         &none &none &none &none &none &none
&trans       &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL        &none &none &none &none &none &none
                        &trans  &trans  &lt_spc NUM_SUB SPACE    &none &none &none
            >;
        };

        /* Layer 3: NUM_SUB */
        num_sub_layer {
            bindings = <
&trans    &kp F12  &kp F7  &kp F8  &kp F9  &kp PRCNT    &none &none &none &none &none &none
&trans    &kp F11  &kp F4  &kp F5  &kp F6  &kp AMPS     &none &none &none &none &none &none
&trans    &kp F10  &kp F1  &kp F2  &kp F3  &kp DLLR     &none &none &none &none &none &none
                   &trans  &trans  &trans               &none &none &none
            >;
        };

        /* Layer 4: SYM */
        sym_layer {
            bindings = <
&trans    &kp SEMI   &kp COLON &kp STAR  &kp AMPS  &kp QUESTION    &none &none &none &none &none &none
&trans    &kp UNDER  &kp AT    &kp MINUS &kp PRCNT &kp SLASH       &none &none &none &none &none &none
&trans    &kp LBRC   &kp LBKT  &kp LPAR  &kp LT    &kp DQT         &none &none &none &none &none &none
                     &trans    &trans    &lt_spc SYM_SUB SPACE     &none &none &none
            >;
        };

        /* Layer 5: SYM_SUB */
        sym_sub_layer {
            bindings = <
&sl NUM    &kp HASH  &kp DLLR  &kp EQUAL &kp PLUS  &kp EXCL     &none &none &none &none &none &none
&kp ENTER  &kp CARET &kp TILDE &kp PIPE  &kp GRAVE &kp BSLH     &none &none &none &none &none &none
&trans     &kp RBRC  &kp RBKT  &kp RPAR  &kp GT    &kp SQT      &none &none &none &none &none &none
                               &sl SYM   &mo FN    &trans       &none &none &none
            >;
        };

        /* Layer 6: FN */
        fn_layer {
            bindings = <
&kt LGUI   &kp PG_UP  &kp PAUSE_BREAK &kp END    &kp HOME   &kp ESC      &none &none &none &none &none &none
&kp LNLCK  &kp PG_DN  &kp UP          &kt LALT   &kt LCTRL  &kp INS      &none &none &none &none &none &none
&kp SLCK   &kp LEFT   &kp DOWN        &kp RIGHT  &kp PSCRN  &kp DEL      &none &none &none &none &none &none
                                      &trans     &trans     &trans       &none &none &none
            >;
        };

        /* Layer 7: SHORT_CUT */
        shortcut_layer {
            /* Layer #7: สำหรับใส่คีย์ลัดต่างๆ เมื่อกดค้างปุ่ม SYM */
            bindings = <
&kp ESC  &kp LC(C)  &kp LC(V)  &kp LC(Z)  &kp LC(Y)  &none    &none &none &none &none &none &none
&kp TAB  &none      &none      &none      &none      &none    &none &none &none &none &none &none
&none    &none      &none      &none      &none      &none    &none &none &none &none &none &none
                               &trans     &trans     &trans    &none &none &none
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};

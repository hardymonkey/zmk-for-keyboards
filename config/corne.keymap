#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LETTER_SUB 1
#define NUM 2
#define NUM_SUB 3
#define SYM 4
#define SYM_SUB 5
#define FN 6
#define SHORTCUT 7

/* ตำแหน่ง key-position ของปุ่ม Space ใน flattened bindings array (แถวนิ้วโป้ง ตัวที่ 3) */
#define SPACE_POS 38

/ {
    behaviors {
        /* Tap-Dance Shift: 1 ที = Shift ปกติ, 2 ที = Shift Lock (&kt), 3 ที = Caps Lock */
        td_shift_advanced: tap_dance_shift_advanced {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SHIFT_ADVANCED";
            #binding-cells = <0>;
            tapping-term-ms = <250>; /* ปรับเวลาหน้าต่างการกดเป็น 250ms เพื่อให้เคาะ 3 ครั้งได้ง่ายขึ้น */
            bindings = <&kp LSHFT>, <&kt LSHFT>, <&kp CAPS>;
        };

        /* Tap-Dance สำหรับ NUM: กด 1 ที = &sl NUM / กด 2 ที = &tog NUM */
        td_num: tap_dance_num {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_NUM";
            #binding-cells = <0>;
            tapping-term-ms = <280>;
            bindings = <&sl NUM>, <&tog NUM>;
        };

        /* 2. Hold-Tap สำหรับ SYM: กดปล่อย = &sl SYM / กดค้าง = เปิด Shortcut Layer (Layer #7) */
        ht_sym_shortcut: hold_tap_sym_shortcut {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SYM_SHORTCUT";
            #binding-cells = <2>;
            flavor = "balanced";       /* ปรับเป็น balanced เพื่อให้เคาะ Tap ได้ไวและเด็ดขาดขึ้น */
            tapping-term-ms = <170>;   /* ลดเวลาลงเล็กน้อยเพื่อให้ส่ง &sl เร็วขึ้น */
            quick-tap-ms = <125>;      /* ช่วยให้กดพิมพ์รัวๆ ต่อเนื่องได้ไม่หลุด */
            bindings = <&mo>, <&sl>;
        };

    };

    combos {
        compatible = "zmk,combos";

        /* --- LETTER layer: space + key -> letter_sub value (19 combos) --- */
        combo_l_p0 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 0>;
            layers = <DEFAULT>;
            bindings = <&kp QUESTION>;
        };
        combo_l_p1 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 1>;
            layers = <DEFAULT>;
            bindings = <&kp J>;
        };
        combo_l_p2 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 2>;
            layers = <DEFAULT>;
            bindings = <&kp M>;
        };
        combo_l_p3 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 3>;
            layers = <DEFAULT>;
            bindings = <&kp B>;
        };
        combo_l_p4 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 4>;
            layers = <DEFAULT>;
            bindings = <&kp MINUS>;
        };
        combo_l_p5 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 5>;
            layers = <DEFAULT>;
            bindings = <&kp AT>;
        };
        combo_l_p12 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 12>;
            layers = <DEFAULT>;
            bindings = <&kp DOT>;
        };
        combo_l_p13 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 13>;
            layers = <DEFAULT>;
            bindings = <&kp V>;
        };
        combo_l_p14 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 14>;
            layers = <DEFAULT>;
            bindings = <&kp C>;
        };
        combo_l_p15 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 15>;
            layers = <DEFAULT>;
            bindings = <&kp L>;
        };
        combo_l_p16 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 16>;
            layers = <DEFAULT>;
            bindings = <&kp Z>;
        };
        combo_l_p17 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 17>;
            layers = <DEFAULT>;
            bindings = <&kp Q>;
        };
        combo_l_p25 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 25>;
            layers = <DEFAULT>;
            bindings = <&kp X>;
        };
        combo_l_p26 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 26>;
            layers = <DEFAULT>;
            bindings = <&kp G>;
        };
        combo_l_p27 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 27>;
            layers = <DEFAULT>;
            bindings = <&kp K>;
        };
        combo_l_p28 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 28>;
            layers = <DEFAULT>;
            bindings = <&kp DQT>;
        };
        combo_l_p29 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 29>;
            layers = <DEFAULT>;
            bindings = <&kp BSPC>;
        };
        combo_l_p36 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 36>;
            layers = <DEFAULT>;
            bindings = <&kp SQT>;
        };
        combo_l_p37 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 37>;
            layers = <DEFAULT>;
            bindings = <&kp COMMA>;
        };

        /* --- NUM layer: space + key -> num_sub value (19 combos) --- */
        combo_n_p0 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 0>;
            layers = <NUM>;
            bindings = <&kp LNLCK>;
        };
        combo_n_p1 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 1>;
            layers = <NUM>;
            bindings = <&kp F12>;
        };
        combo_n_p2 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 2>;
            layers = <NUM>;
            bindings = <&kp F7>;
        };
        combo_n_p3 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 3>;
            layers = <NUM>;
            bindings = <&kp F8>;
        };
        combo_n_p4 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 4>;
            layers = <NUM>;
            bindings = <&kp F9>;
        };
        combo_n_p5 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 5>;
            layers = <NUM>;
            bindings = <&kp PRCNT>;
        };
        combo_n_p12 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 12>;
            layers = <NUM>;
            bindings = <&kp DOT>;
        };
        combo_n_p13 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 13>;
            layers = <NUM>;
            bindings = <&kp F11>;
        };
        combo_n_p14 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 14>;
            layers = <NUM>;
            bindings = <&kp F4>;
        };
        combo_n_p15 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 15>;
            layers = <NUM>;
            bindings = <&kp F5>;
        };
        combo_n_p16 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 16>;
            layers = <NUM>;
            bindings = <&kp F6>;
        };
        combo_n_p17 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 17>;
            layers = <NUM>;
            bindings = <&kp AMPS>;
        };
        combo_n_p25 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 25>;
            layers = <NUM>;
            bindings = <&kp F10>;
        };
        combo_n_p26 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 26>;
            layers = <NUM>;
            bindings = <&kp F1>;
        };
        combo_n_p27 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 27>;
            layers = <NUM>;
            bindings = <&kp F2>;
        };
        combo_n_p28 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 28>;
            layers = <NUM>;
            bindings = <&kp F3>;
        };
        combo_n_p29 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 29>;
            layers = <NUM>;
            bindings = <&kp DLLR>;
        };
        combo_n_p36 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 36>;
            layers = <NUM>;
            bindings = <&kp SQT>;
        };
        combo_n_p37 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 37>;
            layers = <NUM>;
            bindings = <&kp COMMA>;
        };

        /* --- SYM layer: space + key -> sym_sub value (15 combos) --- */
        combo_s_p1 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 1>;
            layers = <SYM>;
            bindings = <&kp HASH>;
        };
        combo_s_p2 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 2>;
            layers = <SYM>;
            bindings = <&kp DLLR>;
        };
        combo_s_p3 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 3>;
            layers = <SYM>;
            bindings = <&kp EQUAL>;
        };
        combo_s_p4 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 4>;
            layers = <SYM>;
            bindings = <&kp PLUS>;
        };
        combo_s_p5 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 5>;
            layers = <SYM>;
            bindings = <&kp EXCL>;
        };
        combo_s_p13 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 13>;
            layers = <SYM>;
            bindings = <&kp CARET>;
        };
        combo_s_p14 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 14>;
            layers = <SYM>;
            bindings = <&kp TILDE>;
        };
        combo_s_p15 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 15>;
            layers = <SYM>;
            bindings = <&kp PIPE>;
        };
        combo_s_p16 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 16>;
            layers = <SYM>;
            bindings = <&kp GRAVE>;
        };
        combo_s_p17 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 17>;
            layers = <SYM>;
            bindings = <&kp BSLH>;
        };
        combo_s_p25 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 25>;
            layers = <SYM>;
            bindings = <&kp RBRC>;
        };
        combo_s_p26 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 26>;
            layers = <SYM>;
            bindings = <&kp RBKT>;
        };
        combo_s_p27 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 27>;
            layers = <SYM>;
            bindings = <&kp RPAR>;
        };
        combo_s_p28 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 28>;
            layers = <SYM>;
            bindings = <&kp GT>;
        };
        combo_s_p29 {
            timeout-ms = <60>;
            key-positions = <SPACE_POS 29>;
            layers = <SYM>;
            bindings = <&kp SQT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Default Layer (มือซ้ายข้างเดียว) */
        default_layer {
            bindings = <
&td_num              &kp P  &kp W  &kp R  &kp A  &kp F                &none &none &none &none &none &none
&kp ENTER            &kp D  &kp T  &kp H  &kp E  &kp O                &none &none &none &none &none &none
&td_shift_advanced   &kp Y  &kp S  &kp N  &kp I  &kp U                &none &none &none &none &none &none
                     &ht_sym_shortcut SHORTCUT SYM   &mo FN     &kp SPACE   &none &none &none
            >;
        };

        /* Layer 1: LETTER_SUB — เก็บไว้เป็นข้อมูลอ้างอิง ไม่ถูกเข้าถึงโดยตรงแล้ว (ใช้ combo แทน) */
        letter_sub {
            bindings = <
&kp QUESTION    &kp J       &kp M  &kp B  &kp MINUS &kp AT      &none &none &none &none &none &none
&kp DOT         &kp V       &kp C  &kp L  &kp Z     &kp Q       &none &none &none &none &none &none
&trans          &kp X       &kp G  &kp K  &kp DQT   &kp BSPC    &none &none &none &none &none &none
                &kp SQT     &kp COMMA   &trans                  &none &none &none
            >;
        };

        /* Layer 2: NUM */
        num_layer {
            bindings = <
&trans       &kp MINUS  &kp N7  &kp N8  &kp N9  &kp SLASH        &none &none &none &none &none &none
&trans       &kp PLUS   &kp N4  &kp N5  &kp N6  &kp STAR         &none &none &none &none &none &none
&trans       &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL        &none &none &none &none &none &none
                        &trans  &trans  &kp SPACE                &none &none &none
            >;
        };

        /* Layer 3: NUM_SUB — เก็บไว้เป็นข้อมูลอ้างอิง ไม่ถูกเข้าถึงโดยตรงแล้ว (ใช้ combo แทน) */
        num_sub_layer {
            bindings = <
&kp LNLCK    &kp F12  &kp F7  &kp F8  &kp F9  &kp PRCNT    &none &none &none &none &none &none
&kp DOT      &kp F11  &kp F4  &kp F5  &kp F6  &kp AMPS     &none &none &none &none &none &none
&trans       &kp F10  &kp F1  &kp F2  &kp F3  &kp DLLR     &none &none &none &none &none &none
                      &kp COMMA     &kp SQT       &trans       &none &none &none
            >;
        };

        /* Layer 4: SYM */
        sym_layer {
            bindings = <
&kp K_CANCEL  &kp SEMI   &kp COLON &kp STAR  &kp AMPS  &kp QUESTION    &none &none &none &none &none &none
&trans        &kp UNDER  &kp AT    &kp MINUS &kp PRCNT &kp SLASH       &none &none &none &none &none &none
&trans        &kp LBRC   &kp LBKT  &kp LPAR  &kp LT    &kp DQT         &none &none &none &none &none &none
                         &trans    &trans    &kp SPACE                 &none &none &none
            >;
        };

        /* Layer 5: SYM_SUB — เก็บไว้เป็นข้อมูลอ้างอิง ไม่ถูกเข้าถึงโดยตรงแล้ว (ใช้ combo แทน) */
        sym_sub_layer {
            bindings = <
&none      &kp HASH  &kp DLLR  &kp EQUAL &kp PLUS  &kp EXCL     &none &none &none &none &none &none
&trans     &kp CARET &kp TILDE &kp PIPE  &kp GRAVE &kp BSLH     &none &none &none &none &none &none
&trans     &kp RBRC  &kp RBKT  &kp RPAR  &kp GT    &kp SQT      &none &none &none &none &none &none
                     &none    &none   &trans                    &none &none &none
            >;
        };

        /* Layer 6: FN */
        fn_layer {
            bindings = <
&kp ESC    &kp PG_UP  &kp PSCRN    &kp SLCK   &kp PAUSE_BREAK    &kp HOME     &none &none &none &none &none &none
&kp TAB    &kp PG_DN  &kp UP       &kt LALT   &kt LCTRL          &kp END      &none &none &none &none &none &none
&trans     &kp LEFT   &kp DOWN     &kp RIGHT  &kp DEL            &kp BSPC     &none &none &none &none &none &none
                                   &kp INS     &trans        &kp LGUI             &none &none &none
            >;
        };

        /* Layer 7: SHORT_CUT */
        shortcut_layer {
            /* Layer #7: สำหรับใส่คีย์ลัดต่างๆ เมื่อกดค้างปุ่ม SYM */
            bindings = <
&kp LG(D)       &kp LC(W)    &kp F2      &kp F5      &kp F11     &kp LC(T)       &none &none &none &none &none &none
&kp LA(TAB)     &kp LC(A)    &kp LC(S)   &kp LC(D)   &kp LC(N)   &kp LC(LS(T))   &none &none &none &none &none &none
&kp LC(LS(Z))   &kp LC(Z)    &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(Y)       &none &none &none &none &none &none
                             &none     &trans     &kp LA(F4)                     &none &none &none
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};

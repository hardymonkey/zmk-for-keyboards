#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define LETTER_SUB 1
#define NUM 2
#define NUM_SUB 3
#define SYM 4
#define SYM_SUB 5
#define FN 6

/ {
    behaviors {
        /* Custom Hold-Tap สำหรับปุ่ม Space (Tap = Space / Hold = สลับไป Sub-Layer) */
        lt_spc: lt_space_sub {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SPACE_SUB";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            quick-tap-ms = <125>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        /* Custom Sticky Key ที่ค้างไว้ได้นานโดยไม่หลุด timeout เอง */
        sk_long: sticky_key_long {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_KEY_LONG";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <60000>; /* ค้างรอไว้ได้นานถึง 60 วินาที */
            quick-release;              /* ปลดล็อกทันทีเมื่อกดปุ่มอักขระถัดไป */
            ignore-modifiers;           /* อนุญาตให้กด Modifier อื่นซ้ำเพื่อผสมกันได้ */
        };

        /* Hold-Tap: กดค้าง = Toggle Caps Lock / กดปล่อย = Sticky Shift */
        ht_shift_caps: hold_tap_shift_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SHIFT_CAPS";
            #binding-cells = <2>;
            flavor = "hold-preferred";      /* เน้นเปิด Caps Lock เมื่อกดค้างเกิน tapping-term */
            tapping-term-ms = <200>;         /* ระยะเวลากดค้าง (มิลลิวินาที) */
            bindings = <&kp>, <&sk_long>;   /* Hold = kp (CAPS), Tap = sk_long (LSHFT) */
        };

        /* Tap-Dance: กด 1 ที = Sticky Shift / กด 2 ทีติดกัน = สั่งยกเลิก Sticky (&skc) */
        td_shift_toggle: tap_dance_shift_toggle {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SHIFT_TOGGLE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&ht_shift_caps CAPS LSHFT>, <&skc>;
        };

        /* --- CONTROL (CTRL) --- */
        /* Tap-Dance: กด 1 ที = Sticky Ctrl / กด 2 ที = Cancel (&skc) */
        td_ctrl: tap_dance_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_CTRL";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk_long LCTRL>, <&skc>;
        };

        /* --- ALT --- */
        /* Tap-Dance: กด 1 ที = Sticky Alt / กด 2 ที = Cancel (&skc) */
        td_alt: tap_dance_alt {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_ALT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk_long LALT>, <&skc>;
        };

        /* --- GUI (WIN / CMD) --- */
        /* Tap-Dance: กด 1 ที = Sticky GUI / กด 2 ที = Cancel (&skc) */
        td_gui: tap_dance_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_GUI";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk_long LGUI>, <&skc>;
        };

    };

    combos {
        compatible = "zmk,combos";
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Default Layer (มือซ้ายข้างเดียว) */
        default_layer {
            bindings = <
&sl NUM            &kp P  &kp W  &kp R  &kp A  &kp F    &none &none &none &none &none &none
&kp ENTER          &kp D  &kp T  &kp H  &kp E  &kp O    &none &none &none &none &none &none
&td_shift_toggle   &kp Y  &kp S  &kp N  &kp I  &kp U    &none &none &none &none &none &none
                         &sl SYM &mo FN &lt_spc LETTER_SUB SPACE &none &none &none
            >;
        };

letter_sub {
            bindings = <
&kp AT   &kp J  &kp M  &kp B  &kp SQT   &kp TAB    &none &none &none &none &none &none
&kp DOT  &kp V  &kp C  &kp L  &kp Z     &kp Q      &none &none &none &none &none &none
&trans   &kp X  &kp G  &kp K  &kp DQT &kp BSPC   &none &none &none &none &none &none
                       &kp COMMA &mo FN &trans     &none &none &none
            >;
        };

        /* Layer 2: NUM */
        num_layer {
            bindings = <
&sl NUM      &kp MINUS  &kp N7  &kp N8  &kp N9  &kp SLASH    &none &none &none &none &none &none
&kp ENTER    &kp PLUS   &kp N4  &kp N5  &kp N6  &kp STAR     &none &none &none &none &none &none
&trans       &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL    &none &none &none &none &none &none
                              &sl SYM &mo FN  &lt_spc NUM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 3: NUM_SUB */
        num_sub_layer {
            bindings = <
&sl NUM    &kp F12  &kp F7  &kp F8  &kp F9  &kp PRCNT    &none &none &none &none &none &none
&kp ENTER  &kp F11  &kp F4  &kp F5  &kp F6  &kp AMPS     &none &none &none &none &none &none
&trans     &kp F10  &kp F1  &kp F2  &kp F3  &kp DLLR     &none &none &none &none &none &none
                    &sl SYM &mo FN  &trans               &none &none &none
            >;
        };

        /* Layer 4: SYM */
        sym_layer {
            bindings = <
&sl NUM    &kp SEMI   &kp COLON &kp STAR &kp AMPS  &kp QUESTION &none &none &none &none &none &none
&kp ENTER  &kp UNDER  &kp AT    &kp MINUS &kp PRCNT &kp SLASH    &none &none &none &none &none &none
&trans     &kp LBRC   &kp LBKT  &kp LPAR  &kp LT    &kp DQT    &none &none &none &none &none &none
                                &sl SYM   &mo FN    &lt_spc SYM_SUB SPACE &none &none &none
            >;
        };

        /* Layer 5: SYM_SUB */
        sym_sub_layer {
            bindings = <
&sl NUM    &kp HASH  &kp DLLR  &kp EQUAL &kp PLUS  &kp EXCL     &none &none &none &none &none &none
&kp ENTER  &kp CARET &kp TILDE &kp PIPE  &kp GRAVE &kp BSLH     &none &none &none &none &none &none
&trans     &kp RBRC  &kp RBKT  &kp RPAR  &kp GT    &kp SQT      &none &none &none &none &none &none
                               &sl SYM   &mo FN    &trans       &none &none &none
            >;
        };

        /* Layer 6: FN */
        fn_layer {
            bindings = <
&td_gui    &kp PG_UP  &kp PAUSE_BREAK &kp END    &kp HOME   &kp ESC      &none &none &none &none &none &none
&kp LNLCK  &kp PG_DN  &kp UP          &td_alt    &td_ctrl   &kp INS      &none &none &none &none &none &none
&kp SLCK   &kp LEFT   &kp DOWN        &kp RIGHT  &kp PSCRN  &kp DEL      &none &none &none &none &none &none
                                      &sl SYM    &trans     &sl NUM      &none &none &none
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
    };
};
